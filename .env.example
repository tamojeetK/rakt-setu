# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SECRET key (sb_secret_...) or legacy service_role key. Never put this in the browser.
SUPABASE_SERVICE_KEY=
# Any long random string — used to hash IP addresses for rate limiting
IP_SALT=
# Any long random string — Vercel sends it to /api/keepalive
CRON_SECRET=
# Name used in WhatsApp messages
SITE_NAME=Rakt Setu
